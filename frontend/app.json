{
  "expo": {
    "name": "Life Strong",
    "slug": "life-strong",
    "scheme": "lifestrong",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vineandvolt.lifestrong",
      "buildNumber": "1"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
