{
  "name": "life-strong-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test:integration": "RUN_DB_TESTS=1 node --import tsx --test tests/training.test.ts",
    "migrate:built": "node dist/db/migrate.js",
    "seed:built": "node dist/db/seed.js",
    "owner:setup": "tsx src/db/owner.ts",
    "owner:setup:built": "node dist/db/owner.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "supertest": "^7.1.3",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
