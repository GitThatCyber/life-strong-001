# Copy to deployment/.env and chmod 600. Never commit the filled file.
# Use two different values generated with: openssl rand -hex 32
DB_ADMIN_PASSWORD=replace_with_64_hex_characters
DB_APP_PASSWORD=replace_with_a_different_64_hex_characters
PUBLIC_HOST=lifestrong-api.vineandvolt.com
RELEASE_TAG=release-prep
# Owner fields are needed only during provisioning/rotation. Remove the password afterward.
OWNER_EMAIL=your-private-owner-email
OWNER_PASSWORD=replace_with_a_unique_password_of_at_least_15_characters
